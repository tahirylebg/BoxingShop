# --- Django -------------------------------------------------------------------
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=True
DJANGO_SETTINGS_MODULE=boxingshop.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:8000

# --- Base de données (PostgreSQL) ---------------------------------------------
# Depuis l'hôte (docker compose up db) : port 5433 ; depuis le conteneur web : db:5432
DATABASE_URL=postgres://boxingshop:boxingshop@localhost:5433/boxingshop
POSTGRES_DB=boxingshop
POSTGRES_USER=boxingshop
POSTGRES_PASSWORD=boxingshop

# --- Cache partagé (table PostgreSQL ; créer avec `manage.py createcachetable`) ou redis://host:6379/1
CACHE_URL=dbcache://boxingshop_cache

# --- Stripe (clés de TEST : https://dashboard.stripe.com/test/apikeys) -------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Fourni par `stripe listen --forward-to localhost:8000/commande/webhook/stripe/`
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- E-mail -------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Boxing Shop <commandes@boxingshop.local>
SHOP_ADMIN_EMAIL=admin@boxingshop.local

# --- Informations légales (factures, mentions légales) -----------------------
SHOP_LEGAL_NAME=Boxing Shop SAS
SHOP_ADDRESS=12 rue du Ring, 75011 Paris
SHOP_SIRET=000 000 000 00000
SHOP_VAT=FR00000000000
SHOP_CONTACT_EMAIL=contact@boxingshop.local

# --- Comptes de démonstration (utilisés UNIQUEMENT par `manage.py seed_demo`) --
DEMO_ADMIN_EMAIL=admin@boxingshop.local
DEMO_ADMIN_PASSWORD=Ring-Admin-2026!
DEMO_CUSTOMER_EMAIL=client@boxingshop.local
DEMO_CUSTOMER_PASSWORD=Ring-Client-2026!
